# Database connection URL (SQLite local database file path)
DATABASE_URL=sqlite:///./uptime_monitor.db

# Interval (in seconds) for the background scheduler to run the URL ping checks
CHECK_INTERVAL_SECONDS=60

# Timeout (in seconds) for HTTP ping requests before marking a URL as down
REQUEST_TIMEOUT_SECONDS=10

# Host binding for the backend FastAPI application (0.0.0.0 for containerized environments)
BACKEND_HOST=0.0.0.0

# Port on which the backend FastAPI application runs
BACKEND_PORT=8000
